# CivicAI frontend environment. Copy to `.env` (or `.env.local`) and adjust.
# Only variables prefixed with VITE_ are exposed to the browser bundle - never put secrets here.

# Base URL of the Django REST API, without a trailing slash.
# Local development: the backend runs on port 8000 (python manage.py runserver).
# Production (e.g. Vercel): the public HTTPS URL of the deployed API, e.g. https://api.example.org/api
VITE_API_URL=http://localhost:8000/api
