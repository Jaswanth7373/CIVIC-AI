# =============================================================================
# CivicAI backend environment variables
# Copy to backend/.env and fill in real values. NEVER commit the real .env file.
# =============================================================================

# --- Django core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex list, e.g. to allow every Vercel preview deployment:
# CORS_ALLOWED_ORIGIN_REGEXES=^https://civicai.*\.vercel\.app$
FRONTEND_URL=http://localhost:5173
TIME_ZONE=Asia/Kolkata

# --- Database (MySQL) ---
DB_ENGINE=mysql
DATABASE_NAME=civicai
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
# Cloud MySQL (Railway / Aiven / PlanetScale-compatible) - overrides the values above:
# DATABASE_URL=mysql://user:password@host:3306/civicai
# Local fallback without MySQL:  DB_ENGINE=sqlite

# --- JWT ---
JWT_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# --- AI engine ---
# demo       -> runs the whole pipeline without trained weights (clearly labelled "Demo AI Mode")
# production -> loads trained models (YOLO weights, Sentence-Transformers, HF sentiment, CLIP)
MODEL_MODE=demo
MODEL_PATH=./ml_models
# YOLO_WEIGHTS=./ml_models/yolo/civicai_yolov8.pt
# TEXT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
# CLIP_MODEL=clip-ViT-B-32
# AI_DEVICE=cpu

# --- Uploads ---
MAX_IMAGE_UPLOAD_MB=8

# --- Maps / geocoding (OpenStreetMap Nominatim) ---
DEFAULT_CITY=Hyderabad
DEFAULT_LAT=17.3850
DEFAULT_LNG=78.4867
GEOCODING_ENABLED=True
# Nominatim policy: identify your application. Placeholder e-mails are rejected (HTTP 403).
# Leave commented to use the default "CivicAI/1.0 (final-year academic project)".
# NOMINATIM_USER_AGENT=CivicAI/1.0 (contact: you@your-college.edu)

# --- Background jobs (optional) ---
USE_CELERY=False
REDIS_URL=redis://127.0.0.1:6379/0

# --- Logging ---
LOG_LEVEL=INFO

# --- Deployment (gunicorn / Render, see ../render.yaml) ---
# SERVE_MEDIA=True            # with DEBUG=False: Django serves uploaded photos (single instance, no object storage)
# NUM_PROXIES=1               # reverse proxies in front of the app (Render/Railway: 1) - correct client IPs for throttling
# WEB_CONCURRENCY=2           # gunicorn worker processes (each holds its own copy of the AI models)
# GUNICORN_THREADS=4          # threads per gunicorn worker
# CIVICAI_ADMIN_EMAIL=admin@your-college.edu   # init_civicai creates / updates this administrator
# CIVICAI_ADMIN_PASSWORD=     # its password (validated by AUTH_PASSWORD_VALIDATORS)
